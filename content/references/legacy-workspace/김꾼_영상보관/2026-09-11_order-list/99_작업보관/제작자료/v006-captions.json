[
  {
    "start": 0,
    "end": 1133333,
    "text": "직원은 말을 했고"
  },
  {
    "start": 1133333,
    "end": 2533333,
    "text": "사장은 들었습니다"
  },
  {
    "start": 2533333,
    "end": 4133333,
    "text": "그런데 주문은 안 들어갔죠"
  },
  {
    "start": 4133333,
    "end": 5500000,
    "text": "제가 더크루에서 풀고 싶은 게"
  },
  {
    "start": 5500000,
    "end": 6800000,
    "text": "바로 이런 틈이에요"
  },
  {
    "start": 6800000,
    "end": 7666667,
    "text": "김꾼입니다"
  },
  {
    "start": 7666667,
    "end": 8033333,
    "text": "직원이"
  },
  {
    "start": 8033333,
    "end": 10166667,
    "text": "“소스 얼마 안 남았어요” 하면"
  },
  {
    "start": 10166667,
    "end": 10700000,
    "text": "“어, 알았어”"
  },
  {
    "start": 10700000,
    "end": 12100000,
    "text": "이렇게 답하잖아요"
  },
  {
    "start": 12100000,
    "end": 13233333,
    "text": "그러다 손님이 부르고"
  },
  {
    "start": 13233333,
    "end": 14166667,
    "text": "배달 오고"
  },
  {
    "start": 14166667,
    "end": 15200000,
    "text": "영업 끝나면"
  },
  {
    "start": 15200000,
    "end": 16533333,
    "text": "“아까 뭐 시키라고 했더라?”"
  },
  {
    "start": 16533333,
    "end": 18466667,
    "text": "그럼 카톡으로 보내면 되잖아"
  },
  {
    "start": 18466667,
    "end": 19700000,
    "text": "“사장님, 내일 쓸 소스"
  },
  {
    "start": 19700000,
    "end": 21066667,
    "text": "두 통 주문해주세요”"
  },
  {
    "start": 21066667,
    "end": 21700000,
    "text": "그거 읽고 나서"
  },
  {
    "start": 21700000,
    "end": 23033333,
    "text": "“아, 이따 시켜야지”"
  },
  {
    "start": 23033333,
    "end": 23800000,
    "text": "이렇게 합니다"
  },
  {
    "start": 23800000,
    "end": 25000000,
    "text": "그런데 그 카톡 밑으로"
  },
  {
    "start": 25000000,
    "end": 26733333,
    "text": "근무 바꿔달라는 얘기"
  },
  {
    "start": 26733333,
    "end": 27700000,
    "text": "마감 사진 같은 게"
  },
  {
    "start": 27700000,
    "end": 28766667,
    "text": "막 쌓이잖아요"
  },
  {
    "start": 28766667,
    "end": 29866667,
    "text": "막상 주문할 때 되면"
  },
  {
    "start": 29866667,
    "end": 30600000,
    "text": "그 메시지가"
  },
  {
    "start": 30600000,
    "end": 31866667,
    "text": "위로 밀려 있는 거죠"
  },
  {
    "start": 31866667,
    "end": 32933333,
    "text": "직원은 말도 했고"
  },
  {
    "start": 32933333,
    "end": 34466667,
    "text": "카톡도 보냈어요"
  },
  {
    "start": 34466667,
    "end": 36033333,
    "text": "사장님도 챙기려고 했고요"
  },
  {
    "start": 36033333,
    "end": 37766667,
    "text": "그런데 주문할 때 볼 목록을"
  },
  {
    "start": 37766667,
    "end": 38700000,
    "text": "머릿속에서"
  },
  {
    "start": 38700000,
    "end": 39700000,
    "text": "카톡에서 다시 찾아"
  },
  {
    "start": 39700000,
    "end": 40633333,
    "text": "모아야 하잖아요"
  },
  {
    "start": 40633333,
    "end": 41533333,
    "text": "그 사이에 한두 개가"
  },
  {
    "start": 41533333,
    "end": 42366667,
    "text": "빠지는 겁니다"
  },
  {
    "start": 42366667,
    "end": 43433333,
    "text": "그래서 더크루 발주는"
  },
  {
    "start": 43433333,
    "end": 44733333,
    "text": "이렇게 쓰는 겁니다"
  },
  {
    "start": 44733333,
    "end": 46000000,
    "text": "상품 목록 적고"
  },
  {
    "start": 46000000,
    "end": 47066667,
    "text": "수량 제출하고"
  },
  {
    "start": 47066667,
    "end": 48233333,
    "text": "사장님이 확인하고"
  },
  {
    "start": 48233333,
    "end": 48500000,
    "text": "끝!"
  },
  {
    "start": 48500000,
    "end": 49900000,
    "text": "우리 가게에서 쓰는 상품을"
  },
  {
    "start": 49900000,
    "end": 51200000,
    "text": "미리 적어놓고"
  },
  {
    "start": 51200000,
    "end": 52266667,
    "text": "직원이 재고를 보면서"
  },
  {
    "start": 52266667,
    "end": 53600000,
    "text": "필요한 수량을 골라"
  },
  {
    "start": 53600000,
    "end": 54600000,
    "text": "제출하면 됩니다"
  },
  {
    "start": 54600000,
    "end": 55433333,
    "text": "홀에서 올린 거"
  },
  {
    "start": 55433333,
    "end": 56500000,
    "text": "주방에서 올린 거"
  },
  {
    "start": 56500000,
    "end": 57100000,
    "text": "이런 것들이"
  },
  {
    "start": 57100000,
    "end": 59000000,
    "text": "사장님 주문표에 다 모입니다"
  },
  {
    "start": 59000000,
    "end": 60966667,
    "text": "사장님은 그 표를 보고"
  },
  {
    "start": 60966667,
    "end": 62033333,
    "text": "거래처에 주문만 하면"
  },
  {
    "start": 62033333,
    "end": 62700000,
    "text": "되는 거예요"
  },
  {
    "start": 62700000,
    "end": 63966667,
    "text": "직원은 매번 상품을"
  },
  {
    "start": 63966667,
    "end": 64900000,
    "text": "안 적어도 되고"
  },
  {
    "start": 64900000,
    "end": 66033333,
    "text": "사장님도 흩어진 말을"
  },
  {
    "start": 66033333,
    "end": 67366667,
    "text": "모을 필요가 없습니다"
  },
  {
    "start": 67366667,
    "end": 68766667,
    "text": "물론 지금 당장 떨어지는 건"
  },
  {
    "start": 68766667,
    "end": 69700000,
    "text": "바로 알려야죠"
  },
  {
    "start": 69700000,
    "end": 71366667,
    "text": "다음 주문부터 빠트리지 않도록"
  },
  {
    "start": 71366667,
    "end": 72600000,
    "text": "재고를 확인하고"
  },
  {
    "start": 72600000,
    "end": 74400000,
    "text": "표를 올릴 시간을 정해주세요"
  },
  {
    "start": 74400000,
    "end": 75600000,
    "text": "“알았어” 했다고"
  },
  {
    "start": 75600000,
    "end": 77033333,
    "text": "주문이 들어가진 않잖아요"
  },
  {
    "start": 77033333,
    "end": 77966667,
    "text": "지금 사장님 가게는"
  },
  {
    "start": 77966667,
    "end": 78833333,
    "text": "주문할 재료를"
  },
  {
    "start": 78833333,
    "end": 80033333,
    "text": "어디에 모으십니까?"
  },
  {
    "start": 80033333,
    "end": 81233333,
    "text": "댓글에 남겨주세요"
  }
]