[
  {
    "start": 0,
    "text": "직원은 말을 했고",
    "emphasis": false,
    "end": 1233333
  },
  {
    "start": 1233333,
    "text": "사장은 들었습니다",
    "emphasis": false,
    "end": 2966667
  },
  {
    "start": 2966667,
    "text": "그런데 주문은 안 들어갔죠",
    "emphasis": true,
    "end": 4900000
  },
  {
    "start": 4900000,
    "text": "제가 더크루에서 풀고 싶은 게",
    "emphasis": false,
    "end": 6366667
  },
  {
    "start": 6366667,
    "text": "바로 이런 틈이에요",
    "emphasis": true,
    "end": 7833333
  },
  {
    "start": 7833333,
    "text": "김꾼입니다",
    "emphasis": false,
    "end": 8866667
  },
  {
    "start": 8866667,
    "text": "직원이",
    "emphasis": false,
    "end": 9266667
  },
  {
    "start": 9266667,
    "text": "“소스 얼마 안 남았어요” 하면",
    "emphasis": false,
    "end": 11533333
  },
  {
    "start": 11533333,
    "text": "“어, 알았어”",
    "emphasis": false,
    "end": 12200000
  },
  {
    "start": 12200000,
    "text": "이렇게 답하잖아요",
    "emphasis": false,
    "end": 13700000
  },
  {
    "start": 13700000,
    "text": "그러다 손님이 부르고",
    "emphasis": false,
    "end": 14900000
  },
  {
    "start": 14900000,
    "text": "배달 오고",
    "emphasis": false,
    "end": 15933333
  },
  {
    "start": 15933333,
    "text": "영업 끝나면",
    "emphasis": false,
    "end": 17200000
  },
  {
    "start": 17200000,
    "text": "“아까 뭐 시키라고 했더라?”",
    "emphasis": false,
    "end": 18766667
  },
  {
    "start": 18766667,
    "text": "그럼 카톡으로 보내면 되잖아",
    "emphasis": false,
    "end": 20966667
  },
  {
    "start": 20966667,
    "text": "“사장님, 내일 쓸 소스",
    "emphasis": false,
    "end": 22300000
  },
  {
    "start": 22300000,
    "text": "두 통 주문해주세요”",
    "emphasis": false,
    "end": 23766667
  },
  {
    "start": 23766667,
    "text": "그거 읽고 나서",
    "emphasis": false,
    "end": 24533333
  },
  {
    "start": 24533333,
    "text": "“아, 이따 시켜야지”",
    "emphasis": false,
    "end": 26000000
  },
  {
    "start": 26000000,
    "text": "이렇게 합니다",
    "emphasis": false,
    "end": 26966667
  },
  {
    "start": 26966667,
    "text": "그런데 그 카톡 밑으로",
    "emphasis": false,
    "end": 28300000
  },
  {
    "start": 28300000,
    "text": "근무 바꿔달라는 얘기",
    "emphasis": false,
    "end": 30133333
  },
  {
    "start": 30133333,
    "text": "마감 사진 같은 게",
    "emphasis": false,
    "end": 31233333
  },
  {
    "start": 31233333,
    "text": "막 쌓이잖아요",
    "emphasis": false,
    "end": 32500000
  },
  {
    "start": 32500000,
    "text": "막상 주문할 때 되면",
    "emphasis": false,
    "end": 33666667
  },
  {
    "start": 33666667,
    "text": "그 메시지가",
    "emphasis": false,
    "end": 34400000
  },
  {
    "start": 34400000,
    "text": "위로 밀려 있는 거죠",
    "emphasis": true,
    "end": 35766667
  },
  {
    "start": 35766667,
    "text": "직원은 말도 했고",
    "emphasis": false,
    "end": 36933333
  },
  {
    "start": 36933333,
    "text": "카톡도 보냈어요",
    "emphasis": false,
    "end": 38600000
  },
  {
    "start": 38600000,
    "text": "사장님도 챙기려고 했고요",
    "emphasis": false,
    "end": 40433333
  },
  {
    "start": 40433333,
    "text": "그런데 주문할 때 볼 목록을",
    "emphasis": false,
    "end": 42266667
  },
  {
    "start": 42266667,
    "text": "머릿속에서",
    "emphasis": false,
    "end": 43333333
  },
  {
    "start": 43333333,
    "text": "카톡에서 다시 찾아",
    "emphasis": false,
    "end": 44433333
  },
  {
    "start": 44433333,
    "text": "모아야 하잖아요",
    "emphasis": false,
    "end": 45466667
  },
  {
    "start": 45466667,
    "text": "그 사이에 한두 개가",
    "emphasis": false,
    "end": 46466667
  },
  {
    "start": 46466667,
    "text": "빠지는 겁니다",
    "emphasis": true,
    "end": 47466667
  },
  {
    "start": 47466667,
    "text": "그래서 더크루 발주는",
    "emphasis": false,
    "end": 48633333
  },
  {
    "start": 48633333,
    "text": "이렇게 쓰는 겁니다",
    "emphasis": false,
    "end": 50033333
  },
  {
    "start": 50033333,
    "text": "상품 목록 적고",
    "emphasis": false,
    "end": 51500000
  },
  {
    "start": 51500000,
    "text": "수량 제출하고",
    "emphasis": false,
    "end": 52766667
  },
  {
    "start": 52766667,
    "text": "사장님이 확인하고",
    "emphasis": false,
    "end": 54133333
  },
  {
    "start": 54133333,
    "text": "끝!",
    "emphasis": true,
    "end": 54600000
  },
  {
    "start": 54600000,
    "text": "우리 가게에서 쓰는 상품을",
    "emphasis": false,
    "end": 56033333
  },
  {
    "start": 56033333,
    "text": "미리 적어놓고",
    "emphasis": false,
    "end": 57533333
  },
  {
    "start": 57533333,
    "text": "직원이 재고를 보면서",
    "emphasis": false,
    "end": 58766667
  },
  {
    "start": 58766667,
    "text": "필요한 수량을 골라",
    "emphasis": false,
    "end": 60233333
  },
  {
    "start": 60233333,
    "text": "제출하면 됩니다",
    "emphasis": false,
    "end": 61433333
  },
  {
    "start": 61433333,
    "text": "홀에서 올린 거",
    "emphasis": false,
    "end": 62366667
  },
  {
    "start": 62366667,
    "text": "주방에서 올린 거",
    "emphasis": false,
    "end": 63533333
  },
  {
    "start": 63533333,
    "text": "이런 것들이",
    "emphasis": false,
    "end": 64133333
  },
  {
    "start": 64133333,
    "text": "사장님 주문표에 다 모입니다",
    "emphasis": true,
    "end": 66133333
  },
  {
    "start": 66133333,
    "text": "사장님은 그 표를 보고",
    "emphasis": false,
    "end": 68366667
  },
  {
    "start": 68366667,
    "text": "거래처에 주문만 하면",
    "emphasis": false,
    "end": 69566667
  },
  {
    "start": 69566667,
    "text": "되는 거예요",
    "emphasis": false,
    "end": 70400000
  },
  {
    "start": 70400000,
    "text": "직원은 매번 상품을",
    "emphasis": false,
    "end": 71666667
  },
  {
    "start": 71666667,
    "text": "안 적어도 되고",
    "emphasis": false,
    "end": 72600000
  },
  {
    "start": 72600000,
    "text": "사장님도 흩어진 말을",
    "emphasis": false,
    "end": 73733333
  },
  {
    "start": 73733333,
    "text": "모을 필요가 없습니다",
    "emphasis": true,
    "end": 75166667
  },
  {
    "start": 75166667,
    "text": "물론 지금 당장 떨어지는 건",
    "emphasis": false,
    "end": 76600000
  },
  {
    "start": 76600000,
    "text": "바로 알려야죠",
    "emphasis": false,
    "end": 77633333
  },
  {
    "start": 77633333,
    "text": "다음 주문부터 빠트리지 않도록",
    "emphasis": false,
    "end": 79500000
  },
  {
    "start": 79500000,
    "text": "재고를 확인하고",
    "emphasis": false,
    "end": 80900000
  },
  {
    "start": 80900000,
    "text": "표를 올릴 시간을 정해주세요",
    "emphasis": true,
    "end": 82833333
  },
  {
    "start": 82833333,
    "text": "“알았어” 했다고",
    "emphasis": false,
    "end": 84366667
  },
  {
    "start": 84366667,
    "text": "주문이 들어가진 않잖아요",
    "emphasis": true,
    "end": 85900000
  },
  {
    "start": 85900000,
    "text": "지금 사장님 가게는",
    "emphasis": false,
    "end": 86900000
  },
  {
    "start": 86900000,
    "text": "주문할 재료를",
    "emphasis": false,
    "end": 87766667
  },
  {
    "start": 87766667,
    "text": "어디에 모으십니까?",
    "emphasis": false,
    "end": 89066667
  },
  {
    "start": 89066667,
    "text": "댓글에 남겨주세요",
    "emphasis": false,
    "end": 90800000
  }
]