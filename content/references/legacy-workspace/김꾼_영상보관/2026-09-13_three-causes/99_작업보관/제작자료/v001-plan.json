  "captions": [
    {
      "source": 0.75,
      "start": 0,
      "text": "직원들 망가지는 거",
      "emphasis": false,
      "end": 1.3
    },
    {
      "source": 2.41,
      "start": 1.3,
      "text": "딱 세 가지 때문입니다",
      "emphasis": true,
      "end": 2.633333
    },
    {
      "source": 4.05,
      "start": 2.633333,
      "text": "첫 번째는 계속 바뀌는 기준",
      "emphasis": false,
      "end": 4.4
    },
    {
      "source": 6.43,
      "start": 4.4,
      "text": "두 번째는 업무 강도 생각 안 한 일",
      "emphasis": false,
      "end": 6.5
    },
    {
      "source": 9.33,
      "start": 6.5,
      "text": "세 번째는 뼈 빠지게 고생했는데",
      "emphasis": false,
      "end": 8.4
    },
    {
      "source": 11.31,
      "start": 8.4,
      "text": "아무도 안 알아주는 구조",
      "emphasis": false,
      "end": 10.1
    },
    {
      "source": 14.15,
      "start": 10.1,
      "text": "김꾼입니다",
      "emphasis": false,
      "end": 10.933333
    },
    {
      "source": 17.46,
      "start": 10.933333,
      "text": "저도 아끼던 직원들",
      "emphasis": false,
      "end": 12.0
    },
    {
      "source": 18.52,
      "start": 12.0,
      "text": "몇 번 잃었거든요",
      "emphasis": false,
      "end": 13.166667
    },
    {
      "source": 20.24,
      "start": 13.166667,
      "text": "그래서 더크루로",
      "emphasis": false,
      "end": 13.866667
    },
    {
      "source": 21.0,
      "start": 13.866667,
      "text": "이 세 가지를 한번 풀어보려고 합니다",
      "emphasis": false,
      "end": 15.6
    },
    {
      "source": 25.1,
      "start": 15.6,
      "text": "첫 번째, 계속 바뀌는 기준",
      "emphasis": true,
      "end": 17.533333
    },
    {
      "source": 30.1,
      "start": 17.533333,
      "text": "어제는 이렇게 하라고 해서",
      "emphasis": false,
      "end": 18.733333
    },
    {
      "source": 31.62,
      "start": 18.733333,
      "text": "그대로 했는데",
      "emphasis": false,
      "end": 19.766667
    },
    {
      "source": 33.14,
      "start": 19.766667,
      "text": "오늘은 왜 이렇게 했냐고 합니다",
      "emphasis": false,
      "end": 21.566667
    },
    {
      "source": 39.89,
      "start": 21.566667,
      "text": "매니저는 괜찮다는데",
      "emphasis": false,
      "end": 23.166667
    },
    {
      "source": 41.85,
      "start": 23.166667,
      "text": "사장님은 다시 하래요",
      "emphasis": false,
      "end": 24.5
    },
    {
      "source": 44.51,
      "start": 24.5,
      "text": "직원 입장에서는",
      "emphasis": false,
      "end": 25.333333
    },
    {
      "source": 45.33,
      "start": 25.333333,
      "text": "누구 말을 따라야 할지 모르잖아요",
      "emphasis": false,
      "end": 27.166667
    },
    {
      "source": 47.69,
      "start": 27.166667,
      "text": "그러니까 매번 물어보게 되죠",
      "emphasis": false,
      "end": 28.766667
    },
    {
      "source": 52.23,
      "start": 28.766667,
      "text": "“사장님, 이거 이렇게 하면 돼요?”",
      "emphasis": false,
      "end": 30.266667
    },
    {
      "source": 54.55,
      "start": 30.266667,
      "text": "“야, 그 정도는 알아서 해야지”",
      "emphasis": false,
      "end": 32.2
    },
    {
      "source": 59.53,
      "start": 32.2,
      "text": "그래서 알아서 했다가",
      "emphasis": false,
      "end": 33.9
    },
    {
      "source": 62.71,
      "start": 33.9,
      "text": "혼난 적이 있는데",
      "emphasis": false,
      "end": 34.8
    },
    {
      "source": 63.61,
      "start": 34.8,
      "text": "어떻게 알아서 하겠어요?",
      "emphasis": true,
      "end": 36.666667
    },
    {
      "source": 68.6,
      "start": 36.666667,
      "text": "그래서 더크루에서는",
      "emphasis": false,
      "end": 37.6
    },
    {
      "source": 69.52,
      "start": 37.6,
      "text": "사장과 직원이 같은 기준을 보고",
      "emphasis": false,
      "end": 39.4
    },
    {
      "source": 71.34,
      "start": 39.4,
      "text": "일하게 만드는 겁니다",
      "emphasis": false,
      "end": 40.666667
    },
    {
      "source": 73.38,
      "start": 40.666667,
      "text": "‘마감 청소’ 한 줄 던져놓으면",
      "emphasis": false,
      "end": 42.633333
    },
    {
      "source": 76.04,
      "start": 42.633333,
      "text": "누군가는 바닥만 닦고",
      "emphasis": false,
      "end": 44.133333
    },
    {
      "source": 78.3,
      "start": 44.133333,
      "text": "누군가는 배수구까지 닦잖아요",
      "emphasis": false,
      "end": 46.033333
    },
    {
      "source": 82.65,
      "start": 46.033333,
      "text": "두 번째, 업무 강도 생각 안 한 일",
      "emphasis": true,
      "end": 48.466667
    },
    {
      "source": 86.29,
      "start": 48.466667,
      "text": "한 명은 홀에서 주문받고",
      "emphasis": false,
      "end": 50.066667
    },
    {
      "source": 88.41,
      "start": 50.066667,
      "text": "음식 나르고",
      "emphasis": false,
      "end": 51.0
    },
    {
      "source": 89.93,
      "start": 51.0,
      "text": "손님 불만까지 받고 있어요",
      "emphasis": false,
      "end": 52.766667
    },
    {
      "source": 93.9,
      "start": 52.766667,
      "text": "다른 한 명은 뒤에서",
      "emphasis": false,
      "end": 53.7
    },
    {
      "source": 95.0,
      "start": 53.7,
      "text": "비품을 정리하고 있고요",
      "emphasis": false,
      "end": 54.9
    },
    {
      "source": 96.2,
      "start": 54.9,
      "text": "둘 다 일하고 있으니까",
      "emphasis": false,
      "end": 56.766667
    },
    {
      "source": 99.2,
      "start": 56.766667,
      "text": "똑같이 하나씩 더 시켜봅니다",
      "emphasis": false,
      "end": 58.566667
    },
    {
      "source": 101.28,
      "start": 58.566667,
      "text": "일 세 개씩 나눠줬다고",
      "emphasis": false,
      "end": 59.766667
    },
    {
      "source": 103.06,
      "start": 59.766667,
      "text": "똑같이 나눈 게 아니잖아요",
      "emphasis": true,
      "end": 61.2
    },
    {
      "source": 106.65,
      "start": 61.2,
      "text": "더 많은 일을 하는 친구가",
      "emphasis": false,
      "end": 62.3
    },
    {
      "source": 107.85,
      "start": 62.3,
      "text": "힘들다고 하면",
      "emphasis": false,
      "end": 63.4
    },
    {
      "source": 110.73,
      "start": 63.4,
      "text": "사장님은 당황합니다",
      "emphasis": false,
      "end": 64.7
    },
    {
      "source": 113.07,
      "start": 64.7,
      "text": "“다 같이 일했는데",
      "emphasis": false,
      "end": 65.433333
    },
    {
      "source": 113.91,
      "start": 65.433333,
      "text": "왜 너만 힘들어?”",
      "emphasis": false,
      "end": 66.6
    },
    {
      "source": 116.17,
      "start": 66.6,
      "text": "더크루로 풀려는 부분이",
      "emphasis": false,
      "end": 67.7
    },
    {
      "source": 117.37,
      "start": 67.7,
      "text": "바로 여기예요",
      "emphasis": false,
      "end": 68.733333
    },
    {
      "source": 121.42,
      "start": 68.733333,
      "text": "체크리스트 배정으로",
      "emphasis": false,
      "end": 69.666667
    },
    {
      "source": 122.36,
      "start": 69.666667,
      "text": "한 명에게 업무가 집중되는지",
      "emphasis": false,
      "end": 71.2
    },
    {
      "source": 123.9,
      "start": 71.2,
      "text": "아닌지를 한눈에 보는 거죠",
      "emphasis": false,
      "end": 72.833333
    },
    {
      "source": 127.64,
      "start": 72.833333,
      "text": "이게 체크만 세면",
      "emphasis": false,
      "end": 74.0
    },
    {
      "source": 128.84,
      "start": 74.0,
      "text": "일의 분포는 잘 안 보이거든요",
      "emphasis": true,
      "end": 75.866667
    },
    {
      "source": 134.0,
      "start": 75.866667,
      "text": "어떤 시간대에",
      "emphasis": false,
      "end": 76.633333
    },
    {
      "source": 134.77,
      "start": 76.633333,
      "text": "무슨 일을 맡았는지 보고",
      "emphasis": false,
      "end": 78.133333
    },
    {
      "source": 138.66,
      "start": 78.133333,
      "text": "다음 배정을 바꾸는 겁니다",
      "emphasis": false,
      "end": 79.533333
    },
    {
      "source": 142.36,
      "start": 79.533333,
      "text": "세 번째, 이게 제일 중요해요",
      "emphasis": true,
      "end": 81.4
    },
    {
      "source": 144.54,
      "start": 81.4,
      "text": "뼈 빠지게 고생했는데",
      "emphasis": false,
      "end": 82.733333
    },
    {
      "source": 145.86,
      "start": 82.733333,
      "text": "아무도 안 알아주는 구조",
      "emphasis": true,
      "end": 84.0
    },
    {
      "source": 151.0,
      "start": 84.0,
      "text": "냉장고 정리해놓고",
      "emphasis": false,
      "end": 84.966667
    },
    {
      "source": 152.0,
      "start": 84.966667,
      "text": "떨어진 비품 채워놓고",
      "emphasis": false,
      "end": 86.6
    },
    {
      "source": 153.64,
      "start": 86.6,
      "text": "다음 사람이 할 일까지",
      "emphasis": false,
      "end": 87.666667
    },
    {
      "source": 154.86,
      "start": 87.666667,
      "text": "다 챙겨놨습니다",
      "emphasis": false,
      "end": 88.766667
    },
    {
      "source": 156.74,
      "start": 88.766667,
      "text": "근데 사장님 왔을 때는",
      "emphasis": false,
      "end": 89.833333
    },
    {
      "source": 157.82,
      "start": 89.833333,
      "text": "누가 미리 해놨는지 알 수가 없죠",
      "emphasis": false,
      "end": 91.9
    },
    {
      "source": 161.18,
      "start": 91.9,
      "text": "그러다 하나라도 빠뜨린 날에는",
      "emphasis": false,
      "end": 93.433333
    },
    {
      "source": 163.32,
      "start": 93.433333,
      "text": "바로 보입니다",
      "emphasis": false,
      "end": 94.433333
    },
    {
      "source": 165.38,
      "start": 94.433333,
      "text": "“이거 왜 안 했어?”",
      "emphasis": true,
      "end": 95.533333
    },
    {
      "source": 167.6,
      "start": 95.533333,
      "text": "직원 입장에서는",
      "emphasis": false,
      "end": 96.166667
    },
    {
      "source": 168.38,
      "start": 96.166667,
      "text": "이런 생각이 들 수밖에 없거든요",
      "emphasis": false,
      "end": 97.8
    },
    {
      "source": 172.0,
      "start": 97.8,
      "text": "“내가 해놓은 건 아무도 모르는데",
      "emphasis": false,
      "end": 99.433333
    },
    {
      "source": 173.62,
      "start": 99.433333,
      "text": "안 한 것만 지적받네”",
      "emphasis": true,
      "end": 101.166667
    },
    {
      "source": 176.56,
      "start": 101.166667,
      "text": "그래서 더크루가 하는 일이",
      "emphasis": false,
      "end": 103.666667
    },
    {
      "source": 189.46,
      "start": 103.666667,
      "text": "그 친구가 해온 일을",
      "emphasis": false,
      "end": 104.833333
    },
    {
      "source": 190.63,
      "start": 104.833333,
      "text": "기록으로 쌓이게 하려는 겁니다",
      "emphasis": false,
      "end": 106.5
    },
    {
      "source": 192.95,
      "start": 106.5,
      "text": "직원 본인도 볼 수 있고",
      "emphasis": false,
      "end": 107.966667
    },
    {
      "source": 194.61,
      "start": 107.966667,
      "text": "사장님도 그걸",
      "emphasis": false,
      "end": 108.7
    },
    {
      "source": 195.91,
      "start": 108.7,
      "text": "구체적으로 알아볼 수 있게 해요",
      "emphasis": false,
      "end": 110.3
    },
    {
      "source": 198.71,
      "start": 110.3,
      "text": "“오늘 냉장고 정리해놨더라",
      "emphasis": false,
      "end": 111.866667
    },
    {
      "source": 201.11,
      "start": 111.866667,
      "text": "덕분에 저녁 준비 편했어”",
      "emphasis": false,
      "end": 113.5
    },
    {
      "source": 203.11,
      "start": 113.5,
      "text": "이렇게요",
      "emphasis": false,
      "end": 114.1
    },
    {
      "source": 206.4,
      "start": 114.1,
      "text": "직원한테 “알아서 해줘”라고",
      "emphasis": false,
      "end": 115.5
    },
    {
      "source": 207.82,
      "start": 115.5,
      "text": "말하기 전에",
      "emphasis": false,
      "end": 116.4
    },
    {
      "source": 208.74,
      "start": 116.4,
      "text": "그 친구가 뭘 보고 판단하고",
      "emphasis": false,
      "end": 118.1
    },
    {
      "source": 210.6,
      "start": 118.1,
      "text": "얼마나 감당하고",
      "emphasis": false,
      "end": 119.166667
    },
    {
      "source": 214.64,
      "start": 119.166667,
      "text": "어디까지 책임져야 하는지",
      "emphasis": false,
      "end": 120.6
    },
    {
      "source": 216.32,
      "start": 120.6,
      "text": "같이 볼 수 있게 해요",
      "emphasis": false,
      "end": 121.766667
    },
    {
      "source": 219.76,
      "start": 121.766667,
      "text": "이게 제가 더크루를",
      "emphasis": false,
      "end": 122.966667
    },
    {
      "source": 221.08,
      "start": 122.966667,
      "text": "만드는 이유입니다",
      "emphasis": true,
      "end": 124.2
    }
  ],
